# Copy to .env and fill in. NEVER commit a filled .env — it holds license keys.
# All values below are placeholders. The server FAILS CLOSED (every key
# verifies as invalid) when LICENSE_KEYS is missing or malformed.

# JSON map of license keys to their plans. Format:
#   {"<raw-key>": {"plan": "free|builder|pro|enterprise",
#                 "bundles": ["crypto.cex", "weather.forecast", ...],
#                 "expiresAt": "2027-01-01T00:00:00Z",   # ISO-8601, or null for no expiry
#                 "label": "human label (never a secret)"}}
# Raw keys are SHA-256 hashed at startup and then discarded; only hashes are kept.
LICENSE_KEYS={"PASTE-YOUR-LICENSE-KEYS-JSON-HERE": {"plan": "builder", "bundles": [], "expiresAt": null, "label": "example"}}

# Daily bundle-call quotas (heartbeat-counted, UTC day). Defaults are generous
# except Free (10,000). Override per deployment:
# QUOTA_FREE=10000
# QUOTA_BUILDER=250000
# QUOTA_PRO=2000000
# QUOTA_ENTERPRISE=50000000

# Optional: Postgres connection string. When unset, the server uses local SQLite
# at SQLITE_PATH. (psycopg must be installed for Postgres.)
# DATABASE_URL=postgresql://dataapi:PASTE-PASSWORD-HERE@db:5432/dataapi
SQLITE_PATH=data/metering.db

# Password for the Postgres service in docker-compose.yml (compose only).
POSTGRES_PASSWORD=PASTE-POSTGRES-PASSWORD-HERE

LOG_LEVEL=INFO
